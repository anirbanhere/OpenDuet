# Copy to openbot/.env; do not copy the legacy Saathi .env or household data.
# Start from a fresh local database/container volume for this fork.
DATABASE_URL=postgres://openbot:openbot@localhost:5432/openbot
KEY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Public development placeholder above; generate a fresh random key before real credentials/data.
PORT=3001
SERVER_PORT=3001
APP_PORT=3010
OPENBOT_SINGLE_USER=true
OPENBOT_HOST=127.0.0.1
OPENBOT_PUBLIC_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3010
TENANT_PACKAGE_DIR=../examples/saathi
COMPOSE_PROJECT_NAME=saathi-openduet
SERVER_IMAGE=saathi-openduet-server:local
COMPUTER_IMAGE=saathi-openduet-computer:local
SUPERVISOR_IMAGE=saathi-openduet-supervisor:local
BOT_IMAGE=saathi-openduet-bot:local
LANGGRAPH_IMAGE=saathi-openduet-langgraph:local

# OpenAI-compatible protocol using one operator-managed OpenRouter key.
BOT_PROVIDER=openai
BOT_MODEL=openrouter/free
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# Choose a specific key-permitted :free model when capacity/tool support requires it.
# The app's model picker is upstream behavior; provider key guardrails still enforce spend.

# Required upstream service; thread/memory data reaches this service when run.
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
INTELLIGENCE_API_KEY=
COPILOTKIT_TELEMETRY_DISABLED=true

# Deliberately unconfigured: Google OAuth, Composio, public messaging, dictation and live voice.
# OpenRouter chat is not speech-to-text. Do not reuse chat credentials as a speech configuration.
