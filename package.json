{
  "name": "saathi-openduet",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Saathi's household-agent customization of OpenDuet, built on OpenBot and CopilotKit.",
  "scripts": {
    "postinstall": "bun install --cwd openbot",
    "start": "bun run saathi:start",
    "upstream:start": "bash scripts/start.sh",
    "upstream:tenant-check": "bun --env-file=openbot/.env scripts/saathi-preflight.ts",
    "saathi:check": "bun --env-file=openbot/.env.self-hosted scripts/saathi-self-hosted-check.ts",
    "saathi:roles": "bun --env-file=openbot/.env.self-hosted scripts/saathi-role-check.ts",
    "saathi:roles:fixture": "bun scripts/saathi-role-check.ts --fixture",
    "saathi:test": "bun test ./openbot/server/tests/saathi-tenant.test.ts",
    "saathi:cloud-start": "bun run upstream:tenant-check && bash scripts/start.sh",
    "saathi:start": "bun --env-file=openbot/.env.self-hosted openbot/server/src/self-hosted/index.ts",
    "saathi:self-hosted:test": "bun test ./openbot/server/tests/self-hosted-store.test.ts ./openbot/server/tests/self-hosted-http.test.ts ./openbot/server/tests/self-hosted-config.test.ts ./openbot/server/tests/self-hosted-answer.test.ts ./openbot/server/tests/self-hosted-web.test.ts ./openbot/server/tests/self-hosted-models.test.ts ./openbot/server/tests/self-hosted-search.test.ts ./openbot/server/tests/self-hosted-appointments.test.ts ./openbot/server/tests/self-hosted-roles.test.ts ./openbot/server/tests/self-hosted-speech.test.ts ./openbot/server/tests/self-hosted-plans.test.ts",
    "upstream:stop": "bash scripts/stop.sh"
  }
}
