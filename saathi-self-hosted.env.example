# Copy to openbot/.env.self-hosted. Threads and reviewed memories stay in local SQLite.
SAATHI_HOST=127.0.0.1
SAATHI_PORT=8790
# Optional absolute local path; default is this checkout's ignored .saathi/state.sqlite.
# SAATHI_DATABASE_PATH=
BOT_MODEL=openrouter/free
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
SAATHI_ALLOW_PAID_MODELS=false
# OpenRouter ceiling in USD per million input/output tokens, effective only after opt-in.
SAATHI_MAX_INPUT_PRICE=0.25
SAATHI_MAX_OUTPUT_PRICE=1.00
# Meta Model API (https://dev.meta.ai). Separate from OpenRouter; billing/credits unverified.
META_API_KEY=
SAATHI_ENABLE_META=false
SAATHI_META_MODELS=muse-spark-1.3
# Optional native Meta read-only lookup; search charges are separate from model tokens.
SAATHI_META_WEB_SEARCH=false
# Independent model roles. References are provider:model; existing provider/cost flags still apply.
# SAATHI_REASONING_MODEL=openrouter:openrouter/free
# SAATHI_CONVERSATION_MODEL=openrouter:openrouter/free
# SAATHI_EXTRACTION_MODEL=disabled
# SAATHI_REASONING_TIMEOUT_MS=60000
# SAATHI_REASONING_MAX_OUTPUT_TOKENS=2048
# Conversation normal chat is capped at 1024 output tokens; native lookup may use its role cap.
# SAATHI_CONVERSATION_MAX_OUTPUT_TOKENS=2048
# Speech is disabled by default. Fixture mode is synthetic lookup/test tones, not ASR/TTS.
SAATHI_STT_PROVIDER=disabled
SAATHI_TTS_PROVIDER=disabled
# SAATHI_STT_MODEL=
# SAATHI_TTS_MODEL=
# SAATHI_STT_LANGUAGES=en-IN,hi-IN,ta-IN
# SAATHI_TTS_LANGUAGES=en-IN,hi-IN,ta-IN
COPILOTKIT_TELEMETRY_DISABLED=true
# No Intelligence key, external memory store, database service, Docker or account vault required.
# Sending chat still sends recent context and reviewed memories to the selected model provider.
