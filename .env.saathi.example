# Copy to openbot/.env. Keep real credentials out of version control.
SAATHI_ENABLED=true
TENANT_PACKAGE_DIR=../examples/saathi
DEPLOYMENT_ID=saathi-local
DATABASE_URL=postgres://openbot:openbot@127.0.0.1:5432/openbot
# Generate a unique base64-encoded 32-byte value before starting.
KEY_ENCRYPTION_KEY=

# Required by this OpenDuet revision for conversation persistence.
# These are deployment credentials, separate from personal LLM keys.
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
INTELLIGENCE_API_KEY=

# Only for a private, loopback-bound local trial. Configure real sign-in for hosting.
OPENBOT_SINGLE_USER=true
OPENBOT_HOST=127.0.0.1
SERVER_PORT=3001
APP_PORT=3010
OPENBOT_PUBLIC_URL=http://localhost:3001
OPENBOT_APP_URL=http://localhost:3010
TRUSTED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# Keep one computer per private Bot when configuring the upstream computer supervisor.
OPENBOT_ONE_COMPUTER_EACH=true
COMPUTER_NAMESPACE=saathi
COMPUTER_TOKEN=
SUPERVISOR_TOKEN=
COMPOSE_PROJECT_NAME=saathi
# The upstream start script sets COMPUTER_SUPERVISOR_URL for its local supervisor.
# When starting manually, set this to your private supervisor address.
COMPUTER_SUPERVISOR_URL=

# Optional speech service. Separate from the user's reasoning-model key.
# TRANSCRIPTION_PROVIDER=openai-compatible
# TRANSCRIPTION_BASE_URL=https://your-approved-speech-service/v1
# TRANSCRIPTION_MODEL=
# TRANSCRIPTION_API_KEY=

COPILOTKIT_TELEMETRY_DISABLED=true
